# ---------------------------------------------------------------------------
# Arthabodh (Sarathi Labs) — free "brains".
# Add ONE key to start; add more for automatic failover.
# Copy this file to .env and fill in what you have. Never commit .env.
#
#   export $(grep -v '^#' .env | xargs) && python3 cli.py --idea "..."
# ---------------------------------------------------------------------------

# Fastest free tier, no credit card: https://console.groq.com/keys
GROQ_API_KEY=

# Free tier in AI Studio, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Many ":free" models behind one key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 120+ open models, free prototyping: https://build.nvidia.com
NVIDIA_API_KEY=

# Free experiment tier: https://console.mistral.ai
MISTRAL_API_KEY=

# --- Optional ---
# Force a specific provider instead of auto-detecting: groq | gemini | openrouter | nvidia | mistral | ollama
# IDEA_ORACLE_BRAIN=groq

# Web server
# PORT=8000
# HOST=0.0.0.0
